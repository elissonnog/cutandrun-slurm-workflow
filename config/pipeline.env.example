# Core inputs
FASTQ_DIR="$projPath/../fastq"
READ1_SUFFIX="_L000_R1_001.fastq.gz"
READ2_SUFFIX="_L000_R2_001.fastq.gz"
BOWTIE2_GENOME_PREFIX="/path/to/bowtie2/genome/prefix"
BOWTIE2_SPIKEIN_PREFIX="/path/to/bowtie2/spikein/prefix"
CHROM_SIZES="/path/to/chrom.sizes"
SEACR_SCRIPT="/path/to/SEACR_1.3.sh"
PICARD_JAR="/path/to/picard.jar"

# Optional control map override. If unset, the generated experiment directory's
# control_map.tsv file is used.
# CONTROL_MAP_FILE="/path/to/control_map.tsv"

# Optional module names for HPC environments that use environment modules.
FASTQC_MODULE="bbc2/fastqc/fastqc-0.12.1"
BOWTIE2_MODULE="bbc2/bowtie2/bowtie2-2.5.1"
SAMTOOLS_MODULE="bbc2/samtools/samtools-1.17"
BEDTOOLS_MODULE="bbc2/bedtools/"
PICARD_MODULE="bbc2/picard/picard-3.0.0"
R_MODULE="bbc2/R/R-4.4.0"

# Tunable parameters
BOWTIE2_THREADS=4
SPIKEIN_THREADS=4
MAX_FRAGMENT_LENGTH=1000
BIN_LENGTH=500
SPIKEIN_SCALE_NUMERATOR=10000
