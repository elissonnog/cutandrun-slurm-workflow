NFCORE_CUTANDRUN_PIPELINE="nf-core/cutandrun"
NEXTFLOW_INPUT_SHEET="/path/to/samplesheet.csv"
NEXTFLOW_OUTDIR="/path/to/output_dir"
NEXTFLOW_GENOME="GRCh38"
NEXTFLOW_PEAKCALLER="seacr,MACS2"

# Optional overrides
# NEXTFLOW_FASTA="/path/to/reference.fa"
# NEXTFLOW_GTF="/path/to/annotation.gtf"
# NEXTFLOW_PROFILE="singularity"
# NEXTFLOW_WORKDIR="/path/to/work"
# NEXTFLOW_CONDA_ENV="/path/to/conda/env"
# NEXTFLOW_RESUME="true"

# Optional Nextflow cluster tuning (read by nextflow/nextflow.config)
# NXF_QUEUE_SIZE="6"
# NXF_SUBMIT_RATE_LIMIT="2sec"
# NXF_CLUSTER_OPTIONS="--partition long"
# NXF_BEFORE_SCRIPT="sleep $(( $(shuf -i 1-30 -n 1) ))"
# NXF_CONTAINER_OPTIONS="--userns"
# NXF_SINGULARITY_ENABLED="true"
# NXF_SINGULARITY_AUTOMOUNTS="true"

# Optional Slurm wrapper settings for nextflow/submit_nfcore_cutandrun.sh
# NEXTFLOW_JOB_NAME="nfcore_cutandrun"
# NEXTFLOW_SLURM_PARTITION="long"
# NEXTFLOW_SLURM_TIME="24:00:00"
# NEXTFLOW_SLURM_CPUS="4"
# NEXTFLOW_SLURM_MEM="64G"
# NEXTFLOW_SBATCH_EXTRA="--qos normal"
